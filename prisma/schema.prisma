generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./data/prod.db"
}

model Building {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  floors Floor[]
}

model Floor {
  id          String   @id @default(cuid())
  buildingId  String
  number      Int      // 0=bodrum, 1, 2, 3, 4
  label       String   // "Bodrum", "1. Kat", etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  building Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  units    Unit[]
  workItems WorkItem[]

  @@index([buildingId])
}

model Unit {
  id          String   @id @default(cuid())
  floorId     String
  number      String   // "101", "2+1-A" etc.
  type        String   // "THREE_PLUS_ONE" or "TWO_PLUS_ONE"
  areaSqm     Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  floor     Floor       @relation(fields: [floorId], references: [id], onDelete: Cascade)
  workItems WorkItem[]
  costRecords CostRecord[]

  @@unique([floorId, number])
  @@index([floorId])
}

model WorkItem {
  id          String   @id @default(cuid())
  unitId      String?
  floorId     String?
  category    String     // "Kaba İşler", "Tesisat", "Boyama", etc.
  name        String
  status      String     @default("TODO") // "TODO", "IN_PROGRESS", "DONE", "BLOCKED"
  priority    String     @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "URGENT"
  progress    Int        @default(0) // 0-100
  dueDate    DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  unit Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  floor Floor?   @relation(fields: [floorId], references: [id], onDelete: SetNull)
  costs CostRecord[]

  @@index([unitId])
  @@index([floorId])
  @@index([status])
}

model CostRecord {
  id          String   @id @default(cuid())
  workItemId  String?
  unitId      String?
  description String
  amount      Float    // TL cinsinden
  receiptUrl  String?  // Fiş/foto linki
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  unit Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([workItemId])
  @@index([unitId])
}

// Seed data model
model SeedData {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
